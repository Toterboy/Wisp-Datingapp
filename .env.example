# =============================================================================
# Supabase-Login/DB-Konfiguration
# Diese Datei kann committet werden – sie enthält KEINE echten Secrets.
# =============================================================================

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key_here

# =============================================================================
# Hinweise:
# - SUPABASE_URL muss die Projekt-API-URL sein (z. B. https://<ref>.supabase.co).
#   Die Dashboard-URL wie https://supabase.com/dashboard/project/... funktioniert
#   NICHT direkt als API-Endpunkt.
# - Die ANON_KEY findest du im Supabase Dashboard unter:
#   Settings -> API -> Project API keys -> anon / public.
# - Kopiere diese Datei nach .env und fülle sie mit echten Werten:
#     cp .env.example .env
# - .env ist in .gitignore eingetragen und darf NIEMALS committet werden.
# =============================================================================
